{
  "name": "macicon",
  "description": "Fast macOS-styled app icon generator",
  "version": "1.1.0",
  "type": "module",
  "module": "./src/cli.ts",
  "bin": {
    "macicon": "./src/index.ts"
  },
  "author": {
    "name": "Kristof Dewilde",
    "email": "code@qrivi.dev"
  },
  "scripts": {
    "clean": "rm -rf ./build",
    "build": "bun build ./src/cli.ts --compile --minify && mkdir -p build && mv ./cli ./build/macicon && rm *.bun-build",
    "check": "biome check ./src",
    "check:write": "biome check --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "bun": "^1.1.27",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jimp": "^1.4.0",
    "zod": "^3.23.8"
  }
}
